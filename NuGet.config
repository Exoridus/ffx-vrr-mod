<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="FahrenheitLocal" value=".workspace/fahrenheit/artifacts/pkg/rel" />
        <add key="FahrenheitLocalDebug" value=".workspace/fahrenheit/artifacts/pkg/dbg" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="FahrenheitLocal">
            <package pattern="Fahrenheit" />
            <package pattern="Fahrenheit.*" />
        </packageSource>
        <packageSource key="FahrenheitLocalDebug">
            <package pattern="Fahrenheit" />
            <package pattern="Fahrenheit.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
