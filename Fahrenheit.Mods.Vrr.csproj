<Project Sdk="Fahrenheit.Sdk/1.0.0-alpha12">
    <PropertyGroup>
        <AssemblyName>fhvrr</AssemblyName>
        <AssemblyTitle>Variable Refresh Rate</AssemblyTitle>
        <Product>Variable Refresh Rate</Product>
        <Description>Experimental 60 Hz simulation and 60/120 FPS presentation for FFX. Native gameplay and VRR validation are pending.</Description>
        <Authors>Thomas</Authors>
        <Version>0.1.0</Version>
        <RepositoryUrl>https://github.com/Exoridus/ffx-vrr-mod</RepositoryUrl>
        <FhManifestFlags>NONE</FhManifestFlags>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <PublishDir>$(MSBuildProjectDirectory)/artifacts/deploy/$(Configuration)/mods/$(AssemblyName)/</PublishDir>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
        <Compile Remove="build/**;.workspace/**;tests/**;obj/**;bin/**" />
    </ItemGroup>
</Project>
